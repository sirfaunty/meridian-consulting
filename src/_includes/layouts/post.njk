---
layout: layouts/base.njk
---
<article class="post">
  <div class="container prose">
    <p class="post-back"><a href="/blog/">← Back to all posts</a></p>
    <h1>{{ title }}</h1>
    {% if date %}<p class="post-meta"><time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time></p>{% endif %}

    {{ content | safe }}

    <p class="post-back"><a href="/blog/">← Back to all posts</a></p>
  </div>
</article>

<section class="cta-band">
  <div class="container cta-inner">
    <h2>{{ brand.cta.label }}</h2>
    <p>{{ brand.contact.phone }} · {{ brand.contact.email }}</p>
    <a class="btn btn-accent" href="{{ brand.cta.url }}">{{ brand.cta.label }}</a>
  </div>
</section>
