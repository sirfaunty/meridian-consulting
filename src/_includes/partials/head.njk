<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{% if title and title != "Home" %}{{ title }} · {{ brand.businessName }}{% else %}{{ brand.businessName }} · {{ brand.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or brand.tagline }}">
  <link rel="canonical" href="{{ brand.siteUrl }}{{ page.url }}">

  <!-- Social sharing preview -->
  <meta property="og:title" content="{{ title }} · {{ brand.businessName }}">
  <meta property="og:description" content="{{ description or brand.tagline }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ brand.siteUrl }}{{ page.url }}">
  <meta property="og:image" content="{{ brand.siteUrl }}{{ brand.logoPath }}">
  <meta name="twitter:card" content="summary_large_image">

  <!-- Structured data for search engines (local SEO). Generated from brand.json. -->
  {% include "partials/schema.njk" %}

  <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml">

  {# Brand fonts — loaded from Google Fonts when enabled in brand.json #}
  {% if brand.typography and brand.typography.useGoogleFonts and (brand.typography.headingFont or brand.typography.bodyFont) %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?{% if brand.typography.headingFont %}family={{ brand.typography.headingFont | replace(' ', '+') }}:wght@400;600;700&{% endif %}{% if brand.typography.bodyFont %}family={{ brand.typography.bodyFont | replace(' ', '+') }}:wght@400;500;600;700&{% endif %}display=swap">
  {% endif %}

  <link rel="stylesheet" href="/assets/css/styles.css">

  <!-- Brand tokens injected from brand.json. Change these and the whole site
       re-skins — colors, fonts, and neutrals all flow from here. -->
  <style>
    :root {
      --color-primary: {{ brand.brandColors.primary }};
      --color-accent: {{ brand.brandColors.accent }};
      --color-text: {{ brand.brandColors.text }};
      --color-background: {{ brand.brandColors.background }};
      {% if brand.brandColors.surface %}--color-surface: {{ brand.brandColors.surface }};{% endif %}
      {% if brand.brandColors.border %}--color-border: {{ brand.brandColors.border }};{% endif %}
      {% if brand.brandColors.muted %}--color-muted: {{ brand.brandColors.muted }};{% endif %}
      {% if brand.typography and brand.typography.headingFont %}--font-head: "{{ brand.typography.headingFont }}", Georgia, "Times New Roman", serif;{% endif %}
      {% if brand.typography and brand.typography.bodyFont %}--font-body: "{{ brand.typography.bodyFont }}", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;{% endif %}
    }
  </style>
</head>
