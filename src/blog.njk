---
layout: layouts/base.njk
title: Blog
description: "News, tips, and updates."
permalink: /blog/
---
<section class="page-header">
  <div class="container">
    <h1>Blog</h1>
  </div>
</section>

<section class="page-body">
  <div class="container">
    {% if collections.posts and collections.posts.length %}
      <ul class="post-list">
        {% for post in collections.posts %}
          <li class="post-list-item">
            <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
            {% if post.date %}<p class="post-meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></p>{% endif %}
            {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
            <p><a href="{{ post.url }}">Read more →</a></p>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="prose">No posts yet — check back soon.</p>
    {% endif %}
  </div>
</section>
